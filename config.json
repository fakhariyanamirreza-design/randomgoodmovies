          "oscar", "academy award", "cannes", "palme d'or", "bafta",
          "golden globe", "venice", "berlinale", "grand prix", "academy award winner"
        ]
      },
      "modern_classic": {
        "min_rating": 8.0,
        "min_year": 1995
      },
      "classic_recommendation": {
        "max_year": 1994
      },
      "short_runtime": {
        "max_runtime": 100
      },
      "influential_film": {
        "min_vote_count": 2000,
        "min_popularity": 20
      },
      "decade_recommendation": {
