      "highly_rated": {
        "min_rating": 8.3,
        "min_vote_count": 3000
      },
      "hidden_gem": {
        "min_rating": 8.0,
        "max_vote_count": 3000
      },
      "director_spotlight": {
        "min_rating": 7.8,
        "known_director_film_count": 5
      },
      "award_recognition": {
        "known_awards_exist": true,
