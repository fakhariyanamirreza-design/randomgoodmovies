  "posting": {
    "telegram_parse_mode": "HTML",
    "overview_max_chars": 320,
    "language": "fa-IR",
    "fallback_language": "en-US",
    "channel_footer": "📢 عضویت در کانال: @RandomGoodMovies",
    "verify_thumbnail_url": false,
    "dry_run": false
  },

  "candidate_pool": {
    "target_per_profile": 8,
    "max_pages_per_profile": 3,
    "max_pages_total": 12,
    "exclude_adult": "false",
    "sort_by": "popularity.desc",
    "page_size": 20
  },

  "scoring": {
    "_help": "امتیاز نهایی = مجموع (سهم هر معیار). هر معیار باید بین 0 تا max رسیده شود و سهمش در max ضرب می‌شود. وزن‌ها باید بین 0 و 1 باشند و مجموعشان 1 شود.",
    "weights": {
      "quality": 0.30,
      "novelty": 0.15,
      "category_diversity": 0.10,
      "genre_diversity": 0.10,
      "director_diversity": 0.10,
      "era_diversity": 0.08,
      "popularity": 0.10,
      "surprise": 0.07
    },
    "quality_max": 100,
    "quality_vote_count_reference": 5000,
    "rating_reference_max": 10,
    "popularity_max": 100,
    "popularity_reference": 100,
    "surprise_vote_count_threshold": 3000
  },

  "weighted_selection": {
    "_help": "به‌جای همیشه انتخاب بالاترین امتیاز، از Top-N با احتمال وزن‌دار بر اساس امتیاز انتخاب می‌شود تا تنوع حفظ شود.",
    "enabled": true,
    "top_n": 3,
    "temperature": 1.2
  },

  "diversity": {
    "_help": "محدودیت‌های انعطاف‌پذیر انتخاب نهایی و پنجره‌های تاریخچه. hard_limit ها اول اعمال می‌شوند؛ اگر هیچ فیلمی باقی نماند soft_limit ها اعمال می‌شوند.",
    "history_window": 10,
    "recent_window": 5,
    "category": {
      "hard_limit": 2,
      "soft_limit": 1,
      "max_consecutive": 2
    },
    "genre": {
      "hard_limit": 3,
      "soft_limit": 2,
      "max_consecutive": 3
    },
    "director": {
      "hard_limit": 2,
      "soft_limit": 1,
      "max_consecutive": 2
    },
    "era": {
      "hard_limit": 4,
      "soft_limit": 2,
      "max_consecutive": 4
    }
  },

  "angles": {
    "_help": "هر angle یک قانون rule-based برای انتخاب و یک‌یاچند الگو (template) برای تولید کپشن دارد.",
    "priority": [
      "highly_rated",
      "hidden_gem",
      "director_spotlight",
      "award_recognition",
      "modern_classic",
      "classic_recommendation",
      "short_runtime",
      "influential_film",
      "decade_recommendation",
      "genre_recommendation",
      "weekend_recommendation"
